{
  "schema": "tla-boundary/1",
  "mode": "education",
  "required_files": [
    "README.md",
    "LICENSING.md",
    "CONTRIBUTING.md",
    ".github/CODEOWNERS",
    ".github/pull_request_template.md"
  ],
  "allowed_top_level": [
    "README.md",
    "LICENSING.md",
    "CONTRIBUTING.md",
    ".gitignore",
    ".github",
    ".tla",
    "tools",
    "templates"
  ],
  "allowed_top_level_patterns": [
    "^season-[0-9]{2}-[a-z0-9-]+$"
  ],
  "forbidden_path_patterns": [
    "(^|/)\\.gitmodules$",
    "(^|/)\\.tla-commercial-canary$",
    "(^|/)release-evidence(/|$)",
    "(^|/)package\\.manifest\\.ya?ml$",
    "(^|/)RELEASE_EVIDENCE\\.json$",
    "(^|/)github-actions(/|$)",
    "\\.commercial\\."
  ]
}
