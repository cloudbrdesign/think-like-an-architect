# Copy to config/learner.env and edit. No secrets belong in this file.

# AWS CLI profile for your sandbox account (leave empty to use your default credentials).
AWS_PROFILE=
# The design requires In-Region models; us-east-1 is the verified region.
AWS_REGION=us-east-1
# Optional: the 12-digit sandbox account you expect. Scripts refuse to run against any other account.
TLA_EXPECTED_ACCOUNT=

# IAM path and optional permissions boundary for the application roles.
# Defaults suit a normal sandbox account. Change them only if your account's deployment role requires them.
TLA_ROLE_PATH=/tla/s01e01/
TLA_PERMISSIONS_BOUNDARY_ARN=
