# Copy to config/learner.env (never commit it) and fill in your own values.
# No secrets belong in this file. Credentials come from your normal AWS credential chain.

# The profile to use, or leave blank to use your default credentials.
AWS_PROFILE=
# The region to deploy into. Set it explicitly - never rely on a shell or profile default.
AWS_REGION=us-east-1

# YOUR AWS account id. Every command confirms this first and refuses if it does not match,
# so a misconfigured profile cannot deploy into the wrong account.
TLA_EXPECTED_ACCOUNT=

# IAM path for the two function roles the stack creates.
TLA_ROLE_PATH=/tla/s01e04/
# Optional. Leave BLANK unless your organisation requires a permissions boundary on new roles.
TLA_PERMISSIONS_BOUNDARY_ARN=

# An AWS Budget that must already exist before anything is created. Create one with alerts first:
# preflight refuses to proceed without it, on purpose.
TLA_BUDGET_NAME=
