# Copy to config/learner.env (git-ignored) and fill in. No secrets belong here.
AWS_PROFILE=
AWS_REGION=us-east-1
# Commands refuse to run unless the credentials belong to this account.
TLA_EXPECTED_ACCOUNT=
# IAM path and optional permissions boundary for the application roles (some sandbox accounts require them).
TLA_ROLE_PATH=/tla/s01e03/
TLA_PERMISSIONS_BOUNDARY_ARN=
# Optional: the AWS Budget preflight should find.
TLA_BUDGET_NAME=
# Optional: override the calibrated relevance threshold (answer quality only; never authorization).
TLA_RELEVANCE_MIN_SCORE=
